---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { MACROS, mesosForMacro } from "../data/taxonomy";

const concepts = await getCollection("concepts");

function countForMacro(slug: string): number {
  return concepts.filter((c) => c.id.startsWith(`${slug}/`)).length;
}
function countForMeso(macroSlug: string, mesoSlug: string): number {
  return concepts.filter((c) => c.id.startsWith(`${macroSlug}/${mesoSlug}/`)).length;
}
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Now" description="Lawrence Lundy-Bryan — deep-tech reference">
  <section class="hero">
    <h1>State of the Future</h1>
    <p>A public reference layer for the technology graph Lawrence Lundy-Bryan tracks. {concepts.length} concepts across nine macro domains — compute, sensing, energy, materials, photonic systems, and the frontier where they meet. Updated nightly from the underlying knowledge base.</p>
  </section>

  <section>
    <div class="grid-3">
      {MACROS.map((m) => (
        <div class="card macro-card">
          <a href={`${BASE}/${m.slug}/`} class="macro-card-head">
            <h2>{m.name}</h2>
            <div class="meta">{countForMacro(m.slug)} concepts</div>
            <p>{m.blurb}</p>
          </a>
          <div class="meso-boxes">
            {mesosForMacro(m.slug).map((meso) => (
              <a href={`${BASE}/${m.slug}/${meso.slug}/`} class="meso-box">
                <span class="meso-name">{meso.name}</span>
                <span class="meta">{countForMeso(m.slug, meso.slug)}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
