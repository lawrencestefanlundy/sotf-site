---
import Base from "../../../layouts/Base.astro";
import RadialGraph from "../../../components/RadialGraph.astro";
import Scorecard from "../../../components/Scorecard.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const concepts = await getCollection("concepts");
  return concepts
    .filter((c) => c.id.split("/").length === 3)
    .map((c) => {
      const [macro, meso, slug] = c.id.split("/");
      return {
        params: { macro, meso, slug },
        props: { concept: c },
      };
    });
}

const { concept } = Astro.props;
const { macro, meso, slug } = Astro.params;
const { Content } = await render(concept);

const MACRO_NAMES: Record<string, string> = {
  "compute": "Compute",
  "memory": "Memory",
  "sensing": "Sensing",
  "communications": "Communications",
  "energy-power": "Energy & Power",
  "manufacturing": "Manufacturing",
  "materials": "Materials",
  "photonic-systems": "Photonic Systems",
  "life-frontier": "Life & Frontier",
  "robotics": "Robotics",
  "semiconductor-process-flow": "Process Flow",
  "ai-software": "AI & Software",
};
const macroName = MACRO_NAMES[macro as string] ?? macro;
const mesoName = (meso as string).replace(/-/g, " ");

// Build cross-cuts: macros (other than this one) that this concept's related_concepts touch.
const allConcepts = await getCollection("concepts");
const slugToMacro = new Map<string, string>();
for (const c of allConcepts) slugToMacro.set(c.data.slug, c.id.split("/")[0]);

const crossCutMacros = new Set<string>();
for (const rel of concept.data.related_concepts ?? []) {
  const otherMacro = slugToMacro.get(rel);
  if (otherMacro && otherMacro !== macro) crossCutMacros.add(otherMacro);
}
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

// Per-page meta description: first real paragraph of the body, markdown stripped,
// truncated at a word boundary (~160 chars). Deterministic — no LLM, stable across builds.
function deriveDescription(raw: string | undefined): string | undefined {
  if (!raw) return undefined;
  const para = raw
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .find((p) => p && !p.startsWith("#") && !p.startsWith("|") && !p.startsWith("```") && !p.startsWith("!["));
  if (!para) return undefined;
  const text = para
    .replace(/\[\[([^\]|]+)\|([^\]]+)\]\]/g, "$2")
    .replace(/\[\[([^\]]+)\]\]/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[*_`>#]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  if (text.length <= 160) return text;
  return text.slice(0, 157).replace(/\s+\S*$/, "") + "…";
}
const description =
  deriveDescription(concept.body) ??
  `${concept.data.canonical_name} — ${macroName} / ${mesoName}. From Lawrence Lundy-Bryan's deep-tech reference, rebuilt nightly.`;

// Stub pages (a handful of KB category placeholders) stay browsable but are
// noindexed until they carry real content — thin pages drag search standing.
const bodyWords = (concept.body ?? "").split(/\s+/).filter(Boolean).length;
const noindex = bodyWords < 60 || (concept.body ?? "").includes("Stub leader page");

// last_updated arrives as a JS Date when the KB YAML leaves it unquoted —
// render it as a plain ISO date, never Date.toString().
function isoDate(v: unknown): string {
  if (v instanceof Date) return v.toISOString().slice(0, 10);
  return String(v ?? "").slice(0, 10);
}
const lastUpdated = concept.data.last_updated ? isoDate(concept.data.last_updated) : "";

const pageUrl = new URL(`${BASE}/${macro}/${meso}/${slug}/`, Astro.site).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    name: concept.data.canonical_name,
    alternateName: concept.data.aliases ?? [],
    description,
    url: pageUrl,
    inDefinedTermSet: {
      "@type": "DefinedTermSet",
      name: "State of the Future — deep-tech reference",
      url: Astro.site?.toString(),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "State of the Future", item: Astro.site?.toString() },
      { "@type": "ListItem", position: 2, name: macroName, item: new URL(`${BASE}/${macro}/`, Astro.site).toString() },
      { "@type": "ListItem", position: 3, name: mesoName, item: new URL(`${BASE}/${macro}/${meso}/`, Astro.site).toString() },
      { "@type": "ListItem", position: 4, name: concept.data.canonical_name, item: pageUrl },
    ],
  },
];
---

<Base title={concept.data.canonical_name} description={description} jsonLd={jsonLd} noindex={noindex} prose={true}>
  <div class="breadcrumb" data-pagefind-ignore>
    <a href={`${BASE}/`}>Now</a> &nbsp;/&nbsp;
    <a href={`${BASE}/${macro}/`}>{macroName}</a> &nbsp;/&nbsp;
    <a href={`${BASE}/${macro}/${meso}/`}>{mesoName}</a> &nbsp;/&nbsp;
    {concept.data.canonical_name}
  </div>

  <h1>{concept.data.canonical_name}</h1>

  {crossCutMacros.size > 0 && (
    <div class="crosscuts">
      <strong>Cross-cuts:</strong>
      {[...crossCutMacros].map((m) => (
        <a class="pill" href={`${BASE}/${m}/`}>{MACRO_NAMES[m] ?? m}</a>
      ))}
    </div>
  )}

  {(concept.data.sources_30d > 0 || concept.data.last_updated) && (
    <div class="meta" style="margin-bottom: 1rem;" data-pagefind-ignore>
      {lastUpdated && `last updated ${lastUpdated}`}
      {concept.data.sources_30d > 0 && ` · +${concept.data.sources_30d} sources in last 30d`}
    </div>
  )}

  {concept.data.scorecard && (
    <Scorecard scorecard={concept.data.scorecard} status={concept.data.scorecard_status} />
  )}

  {concept.data.neighbors && concept.data.neighbors.length > 0 && (
    <div data-pagefind-ignore><RadialGraph centre={concept.data.canonical_name} neighbors={concept.data.neighbors} /></div>
  )}

  <article>
    <Content />
  </article>

  {concept.data.recent_mentions && concept.data.recent_mentions.length > 0 && (
    <section>
      <h2>Recent mentions</h2>
      <ul class="recent-mentions">
        {concept.data.recent_mentions.map((s) => (
          <li>
            <span class="meta">{s.date}</span>
            <span class="title">{s.title}</span>
            <span class="meta">{s.kind}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {concept.data.related_concepts && concept.data.related_concepts.length > 0 && (
    <section>
      <h2>Related concepts</h2>
      <ul class="related-list">
        {concept.data.related_concepts.map((rel) => {
          const otherMacro = slugToMacro.get(rel);
          if (otherMacro) {
            const other = allConcepts.find((c) => c.data.slug === rel);
            return (
              <li>
                <a href={`${BASE}/${other?.id}/`}>{other?.data.canonical_name ?? rel.replace(/-/g, " ")}</a>
                {otherMacro !== macro && (
                  <span class="meta"> &nbsp;{MACRO_NAMES[otherMacro] ?? otherMacro}</span>
                )}
              </li>
            );
          } else {
            return <li>{rel.replace(/-/g, " ")}</li>;
          }
        })}
      </ul>
    </section>
  )}

  {concept.data.frontier && concept.data.frontier.length > 0 && (
    <section>
      <h2>Frontier questions</h2>
      <ul class="frontier-list">
        {concept.data.frontier.map((q: string) => <li>{q}</li>)}
      </ul>
    </section>
  )}
</Base>
