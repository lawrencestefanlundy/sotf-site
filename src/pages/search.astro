---
import Base from "../layouts/Base.astro";
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{/* Search moved into the masthead (available on every page), so this route is
    kept only so existing links and bookmarks to /search/ don't 404: it points
    at the header field and focuses it. */}
<Base title="Search" description="Search the State of the Future reference" prose={true} noindex={true}>
  <div class="breadcrumb"><a href={`${BASE}/`}>Now</a> &nbsp;/&nbsp; Search</div>
  <h1>Search</h1>
  <p class="standfirst">
    Search is in the header now — start typing in the box at the top right to search
    every concept page. Or <a href={`${BASE}/atlas/`}>browse the atlas</a> to see how
    the reference connects.
  </p>

  <script is:inline>
    (() => {
      const focusHeader = () => {
        const el = document.getElementById("site-search-input");
        if (el) el.focus();
      };
      document.addEventListener("DOMContentLoaded", focusHeader);
      document.addEventListener("astro:page-load", focusHeader);
      focusHeader();
    })();
  </script>
</Base>
