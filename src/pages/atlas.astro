---
import Base from "../layouts/Base.astro";
import atlas from "../data/atlas.json";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

// Macro → fill color (same palette as RadialGraph)
const MACRO_FILLS: Record<string, string> = {
  "compute":          "#2B2119",
  "memory":           "#4E4034",
  "sensing":          "#6F6152",
  "communications":   "#3E5A7A",
  "energy-power":     "#8A6A2E",
  "manufacturing":    "#3A2D22",
  "materials":        "#968A78",
  "photonic-systems": "#22304A",
  "life-frontier":    "#5E7F6A",
};
const MACRO_NAMES: Record<string, string> = {
  "compute": "Compute",
  "memory": "Memory",
  "sensing": "Sensing",
  "communications": "Communications",
  "energy-power": "Energy & Power",
  "manufacturing": "Manufacturing",
  "materials": "Materials",
  "photonic-systems": "Photonic Systems",
  "life-frontier": "Life & Frontier",
};

// The force layout runs here, at build time, with a seeded RNG so the map is stable between
// builds. It is the same algorithm the page used to run in the browser on load: O(n^2)
// repulsion over 778 nodes x 300 iterations blocked the main thread for ~2 s (17 Oct 2026).
const W = 1200, H = 800;
function rng(seed: number) {
  return () => { seed |= 0; seed = (seed + 0x6D2B79F5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
}
const rand = rng(1903);
type N = { slug: string; name: string; macro: string; path: string; deg: number; x: number; y: number; vx: number; vy: number };
const nodes: N[] = (atlas.nodes as any[]).map((n) => ({ ...n, x: W / 2 + (rand() - 0.5) * 80, y: H / 2 + (rand() - 0.5) * 80, vx: 0, vy: 0 }));
const byId: Record<string, N> = Object.fromEntries(nodes.map((n) => [n.slug, n]));
const links = (atlas.edges as any[]).map((e) => ({ source: byId[e.a], target: byId[e.b] })).filter((l) => l.source && l.target);
const ITERATIONS = 300, K = 30, REPEL = 800, GRAVITY = 0.02, FRICTION = 0.85;
for (let it = 0; it < ITERATIONS; it++) {
  for (let i = 0; i < nodes.length; i++) {
    for (let j = i + 1; j < nodes.length; j++) {
      const a = nodes[i], b = nodes[j];
      const dx = a.x - b.x, dy = a.y - b.y, d2 = dx * dx + dy * dy + 0.01, f = REPEL / d2, d = Math.sqrt(d2);
      const ux = dx / d, uy = dy / d;
      a.vx += ux * f; a.vy += uy * f; b.vx -= ux * f; b.vy -= uy * f;
    }
  }
  for (const l of links) {
    const dx = l.target.x - l.source.x, dy = l.target.y - l.source.y, d = Math.sqrt(dx * dx + dy * dy) + 0.01, f = (d - K) * 0.05;
    const ux = dx / d, uy = dy / d;
    l.source.vx += ux * f; l.source.vy += uy * f; l.target.vx -= ux * f; l.target.vy -= uy * f;
  }
  for (const n of nodes) {
    n.vx += (W / 2 - n.x) * GRAVITY; n.vy += (H / 2 - n.y) * GRAVITY;
    n.vx *= FRICTION; n.vy *= FRICTION; n.x += n.vx; n.y += n.vy;
  }
}
const r1 = (v: number) => Math.round(v * 10) / 10;
---

<Base title="Atlas" description="Full corpus interactive map">
  <div class="breadcrumb"><a href={`${BASE}/`}>Now</a> &nbsp;/&nbsp; Atlas</div>
  <section class="hero">
    <h1>Atlas</h1>
    <p>The full corpus as a single map. {atlas.nodes.length} concepts, {atlas.edges.length} connections. Node size by degree; colour by macro. Drag to pan, scroll to zoom, click to open.</p>
  </section>

  <div class="atlas-legend">
    {Object.entries(MACRO_NAMES).map(([slug, name]) => (
      <span class="legend-chip">
        <span class="dot" style={`background:${MACRO_FILLS[slug]}`}></span>
        {name}
      </span>
    ))}
  </div>

  <div id="atlas-container">
    <svg id="atlas-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Concept atlas">
      <g id="atlas-zoom">
        <g stroke="#2B211914" stroke-width="1">
          {links.map((l) => <line x1={r1(l.source.x)} y1={r1(l.source.y)} x2={r1(l.target.x)} y2={r1(l.target.y)} />)}
        </g>
        <g stroke="#F7F2E7" stroke-width="1">
          {nodes.map((n) => (
            <a href={n.path}><title>{`${n.name} (${n.macro})`}</title><circle cx={r1(n.x)} cy={r1(n.y)} r={r1(Math.min(8, 2 + Math.sqrt(n.deg)))} fill={MACRO_FILLS[n.macro] ?? "#4E4034"} /></a>
          ))}
        </g>
      </g>
    </svg>
  </div>

  <script is:inline>
    (function () {
      // Pan and zoom only; the layout is already in the markup.
      const svg = document.getElementById("atlas-svg");
      const g = document.getElementById("atlas-zoom");
      if (!svg || !g || svg.dataset.wired === "1") return;
      svg.dataset.wired = "1";
      const W = 1200, H = 800;
      let zoom = 1, panX = 0, panY = 0, dragging = false, sx = 0, sy = 0;
      const apply = () => g.setAttribute("transform", `translate(${panX} ${panY}) scale(${zoom})`);
      svg.addEventListener("wheel", (e) => {
        e.preventDefault();
        const f = e.deltaY < 0 ? 1.1 : 0.9, r = svg.getBoundingClientRect();
        const mx = ((e.clientX - r.left) / r.width) * W, my = ((e.clientY - r.top) / r.height) * H;
        panX = mx - (mx - panX) * f; panY = my - (my - panY) * f; zoom *= f; apply();
      }, { passive: false });
      svg.addEventListener("mousedown", (e) => {
        if (e.target.tagName === "circle") return;
        dragging = true; sx = e.clientX - panX; sy = e.clientY - panY;
      });
      window.addEventListener("mousemove", (e) => { if (dragging) { panX = e.clientX - sx; panY = e.clientY - sy; apply(); } });
      window.addEventListener("mouseup", () => { dragging = false; });
    })();
  </script>

  <style>
    #atlas-container {
      border: 1px solid #D5C9B0;
      background: #EEE6D5;
      margin: 1rem 0 2rem;
      position: relative;
    }
    #atlas-svg {
      display: block;
      width: 100%;
      height: 70vh;
      max-height: 800px;
      cursor: grab;
    }
    #atlas-svg:active { cursor: grabbing; }
    #atlas-status {
      position: absolute;
      top: 0.6rem;
      right: 0.8rem;
      padding: 0.25rem 0.6rem;
      background: #F7F2E7;
      border: 1px solid #D5C9B0;
      font-size: 0.7rem;
    }
    .atlas-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 1.2rem;
      margin: 1rem 0 0.5rem;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.75rem;
      color: #2B211999;
    }
    .legend-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .legend-chip .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }
  </style>
</Base>
