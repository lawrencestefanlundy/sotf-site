---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  jsonLd?: object[];
  noindex?: boolean;
  prose?: boolean; // text-heavy page: centre the whole content column at reading measure
}
const { title, description, jsonLd, noindex, prose } = Astro.props;
// Members pages must never enter the public Pagefind index.
const isMembers = Astro.url.pathname.startsWith("/members");
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const metaDescription = description ?? "State of the Future — Lawrence Lundy-Bryan's deep-tech reference";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "State of the Future",
  url: Astro.site?.toString(),
  author: {
    "@type": "Person",
    name: "Lawrence Lundy-Bryan",
    url: "https://stateofthefuture.substack.com",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <title>{title} · State of the Future</title>
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="State of the Future" />
    <meta property="og:title" content={`${title} · State of the Future`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · State of the Future`} />
    <meta name="twitter:description" content={metaDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {jsonLd && jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="/styles/site.css" />
    <ClientRouter />
  </head>
  <body data-pagefind-ignore={isMembers ? "all" : undefined}>
    <header class="site-header">
      <nav>
        <a href={`${BASE}/`} class="site-title">State of the Future</a>
        <ul class="site-nav" data-pagefind-ignore>
          <li><a href={`${BASE}/`}>Now</a></li>
          <li><a href={`${BASE}/tours/`}>Tours</a></li>
          <li><a href={`${BASE}/writing/`}>Writing</a></li>
          <li><a href={`${BASE}/atlas/`}>Atlas</a></li>
          <li><a href={`${BASE}/about/`}>About</a></li>
        </ul>
        <div class="site-search" data-pagefind-ignore>
          <input
            type="search"
            id="site-search-input"
            placeholder="Search concepts…"
            autocomplete="off"
            aria-label="Search the reference"
            aria-controls="site-search-results"
          />
          <div id="site-search-results" class="search-results" hidden></div>
        </div>
      </nav>
    </header>
    <main class={prose ? "prose-main" : ""}>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="subscribe-cta">
        <p><strong>This page rebuilds itself nightly</strong> from the research base behind my investing. The analysis goes out on the newsletter.</p>
        <iframe
          src="https://stateofthefuture.substack.com/embed"
          width="100%"
          height="120"
          style="border:none; background:transparent; max-width: 480px;"
          frameborder="0"
          scrolling="no"
          title="Subscribe to State of the Future"
          loading="lazy"
        ></iframe>
      </div>
      <p>State of the Future — Lawrence Lundy-Bryan · public reference layer, rebuilt nightly from the underlying KB</p>
    </footer>

    <script is:inline>
      // Header search, Pagefind-backed. Bound once and re-armed on every
      // client-side navigation: ClientRouter means DOMContentLoaded fires only
      // on the first load, which is why the old /search page rendered dead.
      (() => {
        let pagefind = null;
        let loading = null;

        async function getPagefind() {
          if (pagefind) return pagefind;
          if (!loading) {
            loading = import(/* @vite-ignore */ "/pagefind/pagefind.js")
              .then((m) => { m.init(); pagefind = m; return m; })
              .catch(() => null);
          }
          return loading;
        }

        function wire() {
          const input = document.getElementById("site-search-input");
          const panel = document.getElementById("site-search-results");
          if (!input || !panel || input.dataset.wired === "1") return;
          input.dataset.wired = "1";

          let seq = 0;
          const close = () => { panel.hidden = true; panel.replaceChildren(); };

          const run = async (q) => {
            const mine = ++seq;
            if (q.trim().length < 2) return close();
            const pf = await getPagefind();
            if (!pf) {
              const p = document.createElement("p");
              p.className = "search-empty";
              p.textContent = "Search index unavailable.";
              panel.replaceChildren(p);
              panel.hidden = false;
              return;
            }
            const search = await pf.search(q);
            if (mine !== seq) return; // a newer keystroke already won
            const top = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
            if (mine !== seq) return;
            panel.replaceChildren();
            if (!top.length) {
              const p = document.createElement("p");
              p.className = "search-empty";
              p.textContent = "No matches.";
              panel.append(p);
              panel.hidden = false;
              return;
            }
            // Built with DOM methods, not innerHTML. Pagefind excerpts carry
            // <mark> highlight tags, so those are re-created from the parsed
            // text; every other tag is discarded rather than trusted.
            for (const d of top) {
              const a = document.createElement("a");
              a.href = d.url;
              const title = document.createElement("span");
              title.className = "r-title";
              title.textContent = (d.meta && d.meta.title) || d.url;
              const ex = document.createElement("span");
              ex.className = "r-excerpt";
              const parsed = new DOMParser().parseFromString(
                String(d.excerpt || ""), "text/html");
              for (const node of parsed.body.childNodes) {
                if (node.nodeType === Node.TEXT_NODE) {
                  ex.append(node.textContent);
                } else if (node.nodeName === "MARK") {
                  const m = document.createElement("mark");
                  m.textContent = node.textContent;
                  ex.append(m);
                } else {
                  ex.append(node.textContent || "");
                }
              }
              a.append(title, ex);
              panel.append(a);
            }
            panel.hidden = false;
          };

          let t;
          input.addEventListener("input", () => {
            clearTimeout(t);
            const q = input.value;
            t = setTimeout(() => run(q), 140);
          });
          input.addEventListener("keydown", (e) => {
            if (e.key === "Escape") { input.value = ""; close(); input.blur(); }
            if (e.key === "ArrowDown") {
              const first = panel.querySelector("a");
              if (first) { e.preventDefault(); first.focus(); }
            }
          });
          document.addEventListener("click", (e) => {
            if (!e.target.closest(".site-search")) close();
          });
        }

        document.addEventListener("DOMContentLoaded", wire);
        document.addEventListener("astro:page-load", wire);
        wire();
      })();
    </script>
  </body>
</html>
